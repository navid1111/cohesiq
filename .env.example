# Cohesiq consolidated example environment variables
# Copy this to .env and fill values when running the stack locally.

# --- Docker / Postgres ---
POSTGRES_HOST_PORT=5432

# SQLAlchemy / AsyncPG database URL used by the backend
# Example: postgresql+asyncpg://cohesiq:password@postgres:5432/cohesiq
DATABASE_URL=postgresql+asyncpg://cohesiq:cohesiq@postgres:5432/cohesiq

# --- App secrets ---
# Secret used by the backend to sign JWTs / session secrets
SECRET_KEY=change_this_in_production

# Clerk (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding


# --- API URL contract (Next.js) ---
# Read ONLY by Next.js Server Components / Server Actions (Docker internal)
BACKEND_API_URL=http://backend:8000
# Read by client/browser code
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: additional dev origins allowed for Next.js dev server
NEXT_ALLOWED_DEV_ORIGINS=

# --- AI / LLM / Third-party keys ---
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GOOGLE_API_KEY=your_google_api_key  # optional fallback for Gemini embeddings

# --- YouTube / OAuth ---
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=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
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
YOUTUBE_API_KEY=your_youtube_data_api_key

# --- TikTok OAuth ---
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# --- Apify (social scraping) ---
APIFY_API_TOKEN=your_apify_api_token
APPIFY_API_TOKEN=your_apify_api_token  # legacy alias some configs use
APIFY_ACTOR_ID=apify/instagram-scraper
APPIFY_ACTOR_ID=apify/instagram-scraper  # legacy alias
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks/free-tiktok-scraper
APIFY_WAIT_SECS=120

# --- ngrok (optional tunneling) ---
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# --- Misc / Optional ---
# Port or host-specific overrides can be added per-developer as needed.
# Docker Compose reads this file only when it is copied to .env at the
# repository root, or when the value is exported in your shell.

# Host port used to expose the Postgres container. Keep the container-side port
# at 5432; set this to 5433 or another free port if localhost:5432 is occupied.
POSTGRES_HOST_PORT=5432
